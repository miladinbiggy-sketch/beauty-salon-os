# ===== Beauty Salon OS 环境变量模板 =====
# 复制为 .env 后修改：cp .env.example .env

# --- 数据库 ---
POSTGRES_USER=salon
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=salon

# --- API ---
# JWT 签名密钥（至少 32 字符随机串，可用 openssl rand -hex 32 生成）
JWT_SECRET=请改成随机长字符串
CORS_ORIGINS=http://localhost:8080,http://localhost:5174
# 若 API 只能经可信 Caddy 反代访问设 true，否则为 false
TRUST_PROXY=false
# 本地测试可为 memory，正式部署必须 redis（所有 API 副本共享防刷）
RATE_LIMIT_DRIVER=memory
# Cookie 外部访问路径：本地开发 API 根路径为 /，标准独立站 /api，子路径站 /salon-api
SESSION_COOKIE_PATH=/

# --- 跨平台签名中转（V13，可选）---
# JSON 字典："门店UUID:平台代码" -> 32 字节随机密钥(64位hex)，在已获授权的中转服务后使用
# 示例格式：{"11111111-1111-4111-8111-111111111111:custom_bridge":"<64位hex>"}
# 生成单个密钥：openssl rand -hex 32；不要将真实密钥提交到 git、浏览器或聊天记录
PARTNER_WEBHOOK_KEYS_JSON={}

# --- 站点 ---
# 独立域名模式示例：salon.example.jp（自动 HTTPS）
# 本地演示：http://localhost
SALON_DOMAIN=http://localhost
WEB_PORT=8080
WEB_HTTPS_PORT=8443
# 顾客端默认门店（演示门店 ID；正式使用改为你自己的门店 ID）
STORE_ID=11111111-1111-4111-8111-111111111111

# --- 演示数据 ---
# true = 首次部署写入演示门店/账号（owner@demo.salon 等，密码 demo1234）；正式营业请设 false 并自行建店
SEED_DEMO=false

# --- LINE 官方账号（可选）---
# 配置后，顾客档案带 line_user_id 且门店设置 lineConfigured=true 的通知走真实 LINE 推送；
# 未配置时通知以 mock 模式记录（管理端可见），不会假装发送成功。
LINE_CHANNEL_ACCESS_TOKEN=

# --- 本地非 Docker 开发（apps/api、apps/worker 读取）---
# DATABASE_URL=postgres://salon:salon_dev_pw@localhost:5432/salon_dev
# REDIS_URL=redis://localhost:6379
# QUEUE_DRIVER=bullmq
